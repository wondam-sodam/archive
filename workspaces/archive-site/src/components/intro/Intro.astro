---
// 작업실 인트로 — 일러스트 한 장 + 벽걸이 모니터 위 로고.
//   가로 화면(PC): public/assets/intro/scene.webp (16:9)
//   세로 화면(모바일): public/assets/intro/scene-mobile.webp (9:16)
// 스크롤하면 모니터 속 로고가 부드럽게 확대 → 흰색 전환 → 회차 검색 배너가 확대된 상태로 나타나 제자리로 줌아웃
//   → 인트로가 사라지며 그 아래 회차 검색 화면이 드러난다.
// - JS가 없거나 실패하면: 확대 없이 정지 화면 + 바로 아래 아카이브 (스크롤 거리도 추가되지 않음).
// - prefers-reduced-motion: 정지 화면.
// - 로고는 public/assets/brand/logo.png 하나만 교체하면 헤더·인트로 모두 바뀐다.
import { logo } from '../../lib/logo.mjs';
import { SITE } from '../../config/site.mjs';
import { withBase } from '../../lib/paths.mjs';

const scene = withBase('/assets/intro/scene.webp');
const sceneSmall = withBase('/assets/intro/scene-960.webp');
const sceneMobile = withBase('/assets/intro/scene-mobile.webp');
const banner = withBase('/assets/archive/search-banner.webp');
const bannerSmall = withBase('/assets/archive/search-banner-900.webp');
// 모니터 흰 화면 영역 실측값 (일러스트를 바꾸면 다시 실측할 것) → CSS 변수로 화면 비율에 따라 전환
//   PC 1671×941: x 528–1144, y 109–440 / 모바일 941×1672: x 180–761, y 371–693
---
<section class="intro" id="intro" data-intro aria-labelledby="intro-title">
  <div class="intro-sticky">
    <div class="intro-viewport" data-viewport>
      <picture>
        <source media="(max-aspect-ratio: 4/3)" srcset={sceneMobile} />
        <img class="scene-backdrop" src={sceneSmall} alt="" aria-hidden="true" width="960" height="541" decoding="async" />
      </picture>
      <div class="zoomer" data-zoomer aria-hidden="true">
        <div class="stage">
          <picture>
            <source media="(max-aspect-ratio: 4/3)" srcset={sceneMobile} width="941" height="1672" />
            <img class="scene" src={scene} srcset={`${sceneSmall} 960w, ${scene} 1671w`} sizes="max(100vw, 178vh)" alt="" width="1671" height="941" fetchpriority="high" />
          </picture>
          <div class="screen" data-screen>
            <img class="screen-logo" src={logo.src} alt="" width={logo.width} height={logo.height} />
          </div>
        </div>
      </div>
    </div>

    <div class="intro-caption">
      <div class="wrap caption-inner">
        <div>
          <h1 id="intro-title" class="visually-hidden">{SITE.name} 아카이브</h1>
          <p class="slogan">{SITE.slogan}</p>
          <p class="caption-sub">소담과 서원이 같은 미션으로 각자 만든 작은 프로그램을 모아 둔 곳</p>
        </div>
        <div class="caption-actions">
          <label class="fake-search" for="day-search">회차 검색 <span>Day 번호 · 미션 · 작품명</span></label>
          <a class="btn btn-solid" href="#archive">아카이브 바로 보기</a>
          <span class="scroll-hint" aria-hidden="true">스크롤하면 모니터 안으로 ↓</span>
        </div>
      </div>
    </div>

    <div class="whiteout" data-whiteout aria-hidden="true"></div>
    <!-- 흰 화면 뒤 줌아웃: 아래 아카이브의 실제 배너 위치를 따라가다 마지막에 정확히 겹친다 -->
    <div class="reveal" data-reveal aria-hidden="true">
      <img src={banner} srcset={`${bannerSmall} 900w, ${banner} 1600w`} sizes="100vw" alt="" width="1600" height="900" decoding="async" />
    </div>
  </div>
  <p class="visually-hidden">소담(왼쪽)과 서원(오른쪽)이 긴 책상에 나란히 앉아 각자의 노트북 앞에서 턱을 괴고 있고, 가운데 벽걸이 모니터에 원담소담 로고가 떠 있는 작업실 장면입니다.</p>
</section>

<style>
  .intro {
    --vh: calc(100svh - var(--header-h));
    --zoom-run: 0px; /* JS가 확대를 켤 때만 스크롤 거리를 더한다 (data-zoomable) */
    --ar: 1.7758; /* 1671 / 941 */
    --sc-l: 31.6%; --sc-t: 11.58%; --sc-w: 36.92%; --sc-h: 35.28%; /* 모니터 화면 */
    position: relative;
    height: calc(var(--vh) + var(--zoom-run));
    background: #fff;
  }
  /* 확대 모드: 인트로가 겹쳐 있는 아카이브 위에 그려지고, 끝나면(data-done) 사라져 클릭을 넘긴다 */
  .intro[data-zoomable] { --zoom-run: 140svh; z-index: 2; background: transparent; }
  .intro[data-done] { pointer-events: none; }
  .intro[data-done] .intro-sticky { visibility: hidden; }
  .intro-sticky { position: sticky; top: var(--header-h); height: var(--vh); min-height: 420px; display: flex; flex-direction: column; overflow: hidden; }

  .intro-viewport { position: relative; flex: 1 1 auto; min-height: 0; overflow: hidden; background: #fae9e3; container-type: size; border-bottom: 1px solid var(--rule); }
  /* 화면 비율이 일러스트와 다를 때 남는 부분을 같은 그림의 흐린 버전으로 채운다 */
  .scene-backdrop { position: absolute; inset: -8%; width: 116%; height: 116%; max-width: none; object-fit: cover; filter: blur(28px) saturate(1.05); opacity: 0.85; }

  .zoomer { position: absolute; inset: 0; transform-origin: 0 0; transform: translate(var(--tx, 0px), var(--ty, 0px)) scale(var(--zoom, 1)); }
  /* 화면을 꽉 채움(cover). 단 세로 화면에서 그림이 화면보다 25% 이상 길어지면 위아래가 너무 잘리므로
     폭을 줄이고(태블릿 세로 등) 남는 양옆은 흐린 배경이 채운다 */
  .stage {
    position: absolute; left: 50%; top: 46%;
    width: max(100cqw, calc(100cqh * var(--ar)));
    aspect-ratio: var(--ar);
    transform: translate(-50%, -46%);
  }
  @media (max-aspect-ratio: 4/3) {
    .intro { --ar: 0.5628; /* 941 / 1672 */ --sc-l: 19.13%; --sc-t: 22.19%; --sc-w: 61.85%; --sc-h: 19.32%; }
    .stage { width: min(max(100cqw, calc(100cqh * var(--ar))), calc(125cqh * var(--ar))); }
  }
  .scene { width: 100%; height: 100%; }
  .screen { position: absolute; left: var(--sc-l); top: var(--sc-t); width: var(--sc-w); height: var(--sc-h); display: grid; place-items: center; }
  /* 일러스트 속 모니터 화면이 이미 흰색이라 배경 상자를 두지 않는다 — 상자가 있으면 PC에서 서원 머리카락이 모니터 가장자리에서 가려짐 */
  .screen-logo { width: 62%; height: auto; }

  .whiteout { position: absolute; inset: 0; z-index: 2; background: #fff; opacity: var(--white, 0); pointer-events: none; }
  .reveal { display: none; position: absolute; left: 0; top: 0; z-index: 3; opacity: 0; transform-origin: 0 0; pointer-events: none; }
  .intro[data-zoomable] .reveal { display: block; }
  .reveal img { width: 100%; height: 100%; }

  /* ---- 캡션 ---- */
  .intro-caption { flex: none; background: var(--cream); }
  .caption-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; padding-top: 14px; padding-bottom: 14px; flex-wrap: wrap; }
  .slogan { font-family: var(--font-display); font-size: clamp(20px, 2.4vw, 28px); line-height: 1.25; }
  .caption-sub { font-size: 14px; color: var(--muted); margin-top: 2px; }
  .caption-actions { display: flex; align-items: center; gap: 16px; }
  .scroll-hint { display: none; font-size: 13px; color: var(--muted); }
  .intro[data-zoomable] .scroll-hint { display: inline; }

  .fake-search { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border: 1px solid var(--charcoal); background: #fff; font-weight: 700; font-size: 14px; cursor: text; }
  .fake-search span { font-weight: 400; color: var(--muted); }
  @media (max-width: 1000px) and (min-width: 701px) { .fake-search span { display: none; } }
  @media (max-width: 700px) {
    .intro[data-zoomable] { --zoom-run: 120svh; }
    .caption-inner { padding-top: 16px; padding-bottom: 18px; }
    .caption-actions { width: 100%; flex-wrap: wrap; }
    .fake-search { flex: 1 1 100%; height: 52px; }
    .caption-actions .btn { flex: 1 1 100%; }
    .intro[data-zoomable] .scroll-hint { display: none; }
  }
</style>

<script>
  import { startIntro } from './intro-controller';
  startIntro();
</script>
