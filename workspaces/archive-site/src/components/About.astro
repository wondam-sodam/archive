---
// 홈 하단 짧은 소개. 실제 인스타그램 URL은 src/config/site.mjs 에 확정된 것만 넣는다.
import { SITE } from '../config/site.mjs';
import { withBase } from '../lib/paths.mjs';
---
<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap about-inner">
    <img class="about-img" src={withBase('/assets/brand/couple.webp')} alt="손으로 하트를 함께 만드는 소담(왼쪽)과 서원(오른쪽) 캐릭터" width="720" height="720" loading="lazy" />
    <div class="about-text">
      <p class="eyebrow">About</p>
      <h2 id="about-title" class="about-title">{SITE.name}</h2>
      <p class="about-slogan">{SITE.slogan}</p>
      <p>매일 하나의 미션을 정하고, <strong class="c-sodam">소담</strong>과 <strong class="c-seowon">서원</strong>이 각자 AI와 함께 작은 프로그램을 만들어요.
        밤에는 통화하며 서로의 결과물을 보여 주고, 그 기록을 이곳에 모아 둡니다.</p>
      {SITE.instagram ? (
        <p class="about-links">
          <a class="btn btn-solid" href={SITE.instagram} target="_blank" rel="noopener noreferrer">인스타그램 ↗</a>
          {SITE.instagramSodam && <a class="text-link c-sodam" href={SITE.instagramSodam} target="_blank" rel="noopener noreferrer">소담</a>}
          {SITE.instagramSeowon && <a class="text-link c-seowon" href={SITE.instagramSeowon} target="_blank" rel="noopener noreferrer">서원</a>}
        </p>
      ) : (
        <p class="about-note">인스타그램 계정은 곧 연결할 예정이에요.</p>
      )}
    </div>
  </div>
</section>

<style>
  .about { border-top: 1px solid var(--rule); padding: clamp(40px, 7vw, 80px) 0; }
  .about-inner { display: grid; grid-template-columns: minmax(180px, 300px) 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .about-img { width: 100%; height: auto; }
  .about-text { display: grid; gap: 12px; max-width: 56ch; }
  .about-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 3.6vw, 40px); line-height: 1.1; }
  .about-slogan { font-weight: 700; font-size: 18px; }
  .c-sodam { color: var(--lilac-ink); }
  .c-seowon { color: var(--khaki-ink); }
  .about-links { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .about-note { font-size: 14px; color: var(--muted); }
  @media (max-width: 640px) { .about-inner { grid-template-columns: 1fr; } .about-img { max-width: 240px; } }
</style>
