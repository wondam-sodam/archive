---
// 홈 하단 짧은 소개. 웹사이트 전용 프로필 일러스트(public/assets/about/profile.webp)를 쓴다.
// (인스타그램 프로필 이미지와는 별개 — 여기서 쓰지 않는다)
// 인스타그램 링크는 src/config/social.json 에 값이 있는 것만 표시된다.
import { SITE, INSTAGRAM_LINKS } from '../config/site.mjs';
import { withBase } from '../lib/paths.mjs';

const handleOf = (url: string) => url.replace(/^https:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '');
---
<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap about-inner">
    <img class="about-img" src={withBase('/assets/about/profile.webp')} alt="턱을 괴고 나란히 앉아 웃고 있는 소담(왼쪽)과 서원(오른쪽) 캐릭터" width="720" height="720" loading="lazy" decoding="async" />
    <div class="about-text">
      <p class="eyebrow">About</p>
      <h2 id="about-title" class="about-title">{SITE.name}</h2>
      <p class="about-slogan">{SITE.slogan}</p>
      <p>매일 하나의 미션을 정하고, <strong class="c-sodam">소담</strong>과 <strong class="c-seowon">서원</strong>이 각자 AI와 함께 작은 프로그램을 만들어요.
        밤에는 통화하며 서로의 결과물을 보여 주고, 그 기록을 이곳에 모아 둡니다.</p>
      {INSTAGRAM_LINKS.length > 0 ? (
        <ul class="ig-links" aria-label="인스타그램">
          {INSTAGRAM_LINKS.map((l) => (
            <li>
              <a class={`ig-link ig-${l.key}`} href={l.url} target="_blank" rel="noopener noreferrer">
                <span class="ig-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5.5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" /></svg>
                </span>
                <span class="ig-text">
                  <span class="ig-label">{l.label}</span>
                  <span class="ig-handle">@{handleOf(l.url!)}</span>
                </span>
                <span class="visually-hidden">(새 창에서 인스타그램 열기)</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="about-note">인스타그램 계정은 곧 연결할 예정이에요.</p>
      )}
    </div>
  </div>
</section>

<style>
  .about { padding: clamp(40px, 7vw, 80px) 0; }
  .about-inner { display: grid; grid-template-columns: minmax(200px, 340px) 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .about-img { width: 100%; height: auto; }
  .about-text { display: grid; gap: 12px; max-width: 56ch; }
  .about-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 3.6vw, 40px); line-height: 1.1; }
  .about-slogan { font-weight: 700; font-size: 18px; }
  .c-sodam { color: var(--lilac-ink); }
  .c-seowon { color: var(--khaki-ink); }
  .about-note { font-size: 14px; color: var(--muted); }

  /* 인스타그램: 각자 색을 담은 말랑한 알약 모양 버튼 */
  .ig-links { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .ig-link {
    --ig-bg: #f6eef3; --ig-dot: linear-gradient(135deg, var(--lilac), #e7a6b8);
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 52px; padding: 6px 20px 6px 6px; border-radius: 999px;
    background: var(--ig-bg); text-decoration: none; color: var(--charcoal);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .ig-sodam { --ig-bg: #efeaf7; --ig-dot: linear-gradient(135deg, #b3a6d6, var(--lilac)); }
  .ig-seowon { --ig-bg: #edf0e6; --ig-dot: linear-gradient(135deg, #b4c19b, var(--khaki)); }
  .ig-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ig-dot); color: #fff; flex: none; }
  .ig-text { display: grid; line-height: 1.25; }
  .ig-label { font-size: 12px; color: var(--muted); }
  .ig-handle { font-weight: 700; font-size: 15px; overflow-wrap: anywhere; }
  .ig-link:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(126, 111, 168, 0.18); }
  .ig-link:focus-visible { outline: 2px solid var(--lilac); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .ig-link { transition: none; } .ig-link:hover { transform: none; } }

  @media (max-width: 640px) { .about-inner { grid-template-columns: 1fr; } .about-img { max-width: 280px; } }
</style>
